  "cards": [
    {
      "dot": "cyan",
      "title": "Build once, offline",
      "items": [
        "Chunks follow each contract's own numbering; the unnumbered preamble is kept",
        "Type, law and parties are extracted once, never at query time"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scope picks the retriever",
      "items": [
        "No doc_id: dense only, recall@5 0.363",
        "With doc_id: dense + BM25 + cross-encoder, recall@5 0.762. The audit agent is dense only"
      ]
    },
    {
      "dot": "rose",
      "title": "Verified in code",
      "items": [
        "A claim is dropped unless its citation was retrieved and its quote matches the chunk (0.95)",
        "If every claim is dropped the answer becomes a refusal"
      ]
    }
  ]
