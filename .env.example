# Copy to .env (gitignored). The API loads it at startup.

# Set this to generate answers with Groq instead of a local Ollama model.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Default: openai/gpt-oss-120b
# GROQ_MODEL=openai/gpt-oss-20b

# Optional. Force a provider: groq | ollama (default: groq if GROQ_API_KEY is set)
# LLM_PROVIDER=ollama
